     [2m  501 [22m[48;2;34;92;43m[38;2;255;255;255m+          MAX_DIV => 256  -- Support division up to 256[39m[49m
     [2m  502 [22m[48;2;34;92;43m[38;2;255;255;255m+      )[39m[49m
     [2m  503 [22m[48;2;34;92;43m[38;2;255;255;255m+      port map ([39m[49m
