# Module Dependency Configuration
# This file defines the build order and dependencies between modules

# Define module dependencies
# Format: MODULE_DEPS_<module_name> = <space-separated list of dependencies>
# clk_divider is now part of volo_common (no separate module needed)
MODULE_DEPS_probe_driver = volo_common
MODULE_DEPS_SimpleWaveGen = volo_common

# Define the build order (modules will be built in this order)
MODULE_BUILD_ORDER = probe_driver SimpleWaveGen stoplight

# Define which modules provide shared libraries
# These modules will be built first and their objects will be available to dependent modules
# volo_common includes: Moku_Voltage_pkg, clk_divider_core
SHARED_MODULES = volo_common