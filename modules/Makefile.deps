# Module Dependency Configuration
# This file defines the build order and dependencies between modules

# Define module dependencies
# Format: MODULE_DEPS_<module_name> = <space-separated list of dependencies>

# Application modules that depend on shared modules
MODULE_DEPS_instruments/SimpleWaveGen = shared/volo_common
MODULE_DEPS_instruments/EMFI-Seq = shared/volo_common
MODULE_DEPS_instruments/PulseStar = shared/volo_common

# Define the build order (modules will be built in this order)
MODULE_BUILD_ORDER = instruments/SimpleWaveGen instruments/EMFI-Seq instruments/PulseStar

# Define which modules provide shared libraries
# These modules will be built first and their objects will be available to dependent modules
# Shared modules include: volo_common, volo_pinata_tx, and all other volo_* utilities
SHARED_MODULES = shared/volo_common shared/volo_pinata_tx shared/volo_barrel_shifter shared/volo_basic_trigger_box shared/volo_delay_line shared/volo_encoder shared/volo_parity_checker shared/volo_sipo shared/volo_voltage_threshold_trigger
