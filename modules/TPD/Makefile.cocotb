# Makefile for cocotb simulation of EMFI_FSM
# Uses GHDL as the simulator

# Simulator selection
SIM ?= ghdl

# VHDL standard
VHDL_STANDARD = 08

# VHDL source files (compile order matters)
VHDL_SOURCES = core/emfi-fsm.vhd core/tpd-med.vhd

# Top-level entity (change to emfi_fsm to test FSM only)
TOPLEVEL = tpd_med

# Python test module (without .py extension)
# Options: emfi_fsm_test_002 (FSM only) or tpd_med_test_001 (wrapper)
MODULE = tpd_med_test_001

# GHDL-specific settings
GHDL_ARGS = --std=$(VHDL_STANDARD)

# Optional: Enable waveform generation
WAVES ?= 0
ifeq ($(WAVES),1)
    SIM_ARGS += --wave=emfi_fsm.ghw
endif

# Include cocotb's Makefile
include $(shell cocotb-config --makefiles)/Makefile.sim

# Help target
.PHONY: help
help:
	@echo "Cocotb Makefile for TPD Module Tests"
	@echo ""
	@echo "Targets:"
	@echo "  make              - Run current test (see MODULE below)"
	@echo "  make WAVES=1      - Run tests and generate waveform"
	@echo "  make clean        - Clean build artifacts"
	@echo "  make help         - Show this help message"
	@echo ""
	@echo "Test Selection (edit Makefile to change):"
	@echo "  FSM only:  TOPLEVEL=emfi_fsm    MODULE=emfi_fsm_test_002"
	@echo "  Wrapper:   TOPLEVEL=tpd_med     MODULE=tpd_med_test_001"
	@echo ""
	@echo "Current Configuration:"
	@echo "  SIM=$(SIM)"
	@echo "  TOPLEVEL=$(TOPLEVEL)"
	@echo "  MODULE=$(MODULE)"
	@echo "  VHDL_STANDARD=$(VHDL_STANDARD)"
